<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport"
        content="width=device-width, initial-scale=1.0, user-scalable=no">

  <title>City Drive</title>

  <link rel="stylesheet" href="style.css">
</head>

<body>

<div id="game">

  <div id="sun"></div>

  <!-- CITY -->
  <div class="city">
    <div class="building"><div class="window"></div></div>
    <div class="building"><div class="window"></div></div>
    <div class="building"><div class="window"></div></div>
    <div class="building"><div class="window"></div></div>
    <div class="building"><div class="window"></div></div>
    <div class="building"><div class="window"></div></div>
  </div>

  <!-- ROAD -->
  <div class="road">
    <div class="lines"></div>
  </div>

  <!-- PLAYER CAR -->
  <div id="car">

    <div class="car-body"></div>

    <div class="window-front"></div>
    <div class="window-back"></div>

    <div class="wheel w1"></div>
    <div class="wheel w2"></div>
    <div class="wheel w3"></div>
    <div class="wheel w4"></div>

  </div>

  <!-- HUD -->
  <div id="hud">

    <div class="panel">
      SPEED:
      <span id="speed">0</span>
      KM/H
    </div>

    <div class="panel">
      SCORE:
      <span id="score">0</span>
    </div>

  </div>

  <!-- MOBILE CONTROLS -->
  <div class="controls">

    <button class="control" id="left">
      ◀
    </button>

    <button class="control" id="right">
      ▶
    </button>

  </div>

  <!-- START SCREEN -->
  <div id="start">

    <h1>🚗 CITY DRIVE</h1>

    <p>
      Drive • Avoid Traffic • Collect Coins
    </p>

    <button onclick="startGame()">
      START GAME
    </button>

  </div>

  <!-- GAME OVER -->
  <div id="gameover">

    <h2>GAME OVER</h2>

    <p>
      Score:
      <span id="finalScore">0</span>
    </p>

    <button id="restart"
            onclick="location.reload()">
      PLAY AGAIN
    </button>

  </div>

</div>

<script src="game.js"></script>

</body>
</html>
